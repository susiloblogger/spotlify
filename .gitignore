# ==============================================================================
# Spotlify - GNOME Shell Extension (.gitignore)
# ==============================================================================

# --- GNOME Shell Extension Build Artifacts ---
# Compiled GSettings schemas (generated by glib-compile-schemas / make schemas)
gschemas.compiled
schemas/gschemas.compiled

# Packaged extension release zip (generated by gnome-extensions pack / make pack)
*.shell-extension.zip

# Build directories
build/
_build/
dist/

# --- Local Cache & Runtime Logs ---
.cache/
*.log

# --- Operating System Files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
*~
*.swp
*.swo

# --- Editor & IDE Files ---
.idea/
*.sublime-workspace
*.sublime-project
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/extensions.json

# --- Node / Tooling Dependencies (if used) ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Environment & Local Overrides ---
.env
.env.local
.env.*.local
